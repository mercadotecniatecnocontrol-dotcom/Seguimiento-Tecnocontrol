# Archivo de ejemplo para variables de entorno. 
# Copia este archivo y renómbralo a .env y llena los valores.

# URL de conexión a tu base de datos Supabase (Transaction o Session pooler, preferiblemente Session)
DATABASE_URL="postgresql://postgres.[tu_id_de_proyecto]:[tu_password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres"
